{
  "name": "trak",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "svelte-check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "check": "pnpm run svelte-check && eslint . && pnpm run lint",
    "check:fix": "pnpm run svelte-check && eslint . && pnpm run format",
    "test:unit": "vitest",
    "test": "pnpm run test:unit --run",
    "storybook": "storybook dev -p 6006"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@chromatic-com/storybook": "^5.2.1",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.5.0",
    "@storybook/addon-docs": "^10.5.0",
    "@storybook/addon-svelte-csf": "^5.1.2",
    "@storybook/addon-vitest": "^10.5.0",
    "@storybook/sveltekit": "^10.5.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/node": "^22",
    "@vitest/browser-playwright": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^10.5.0",
    "eslint-plugin-svelte": "^3.19.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.1.0",
    "sass-embedded": "^1.100.0",
    "storybook": "^10.5.0",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@flightlesslabs/dodo-ui": "^0.36.10",
    "@flightlesslabs/dodo-ui-bits": "^0.11.3",
    "@flightlesslabs/dodo-ui-date": "^0.4.34",
    "@flightlesslabs/dodo-ui-numeric": "^0.2.32",
    "@iconify/svelte": "^5.2.2",
    "@internationalized/date": "^3.12.2",
    "bits-ui": "^2.18.1",
    "dayjs": "^1.11.21",
    "dexie": "^4.4.4",
    "nanoid": "^6.0.0",
    "svelte-number-format": "^2.0.0"
